rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function isSelf(uid) {
      return signedIn() && request.auth.uid == uid;
    }

    function isMatchMember(matchId) {
      return signedIn()
        && exists(/databases/$(database)/documents/matches/$(matchId))
        && request.auth.uid in get(/databases/$(database)/documents/matches/$(matchId)).data.userIds;
    }

    function hasBothLikes(userIds) {
      return userIds.size() == 2
        && userIds[0] != userIds[1]
        && exists(/databases/$(database)/documents/likes/$(userIds[0] + '_' + userIds[1]))
        && exists(/databases/$(database)/documents/likes/$(userIds[1] + '_' + userIds[0]));
    }

    match /users/{uid} {
      allow create: if isSelf(uid)
        && request.resource.data.uid == uid
        && request.resource.data.email == request.auth.token.email;
      allow get: if isSelf(uid)
        || (signedIn() && resource.data.isProfileComplete == true);
      allow list: if signedIn() && resource.data.isProfileComplete == true;
      allow update: if isSelf(uid)
        && request.resource.data.uid == resource.data.uid
        && request.resource.data.email == resource.data.email
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'displayName',
          'dateOfBirth',
          'city',
          'bio',
          'interests',
          'profilePhoto',
          'createdAt',
          'updatedAt',
          'isProfileComplete',
          'isVerified',
          'vibeScore',
          'distance'
        ])
        && request.resource.data.createdAt == resource.data.createdAt;
      allow delete: if isSelf(uid);
    }

    match /likes/{likeId} {
      allow create, update: if signedIn()
        && request.resource.data.fromUserId == request.auth.uid
        && likeId == request.auth.uid + '_' + request.resource.data.toUserId;
      allow read: if signedIn()
        && (resource.data.fromUserId == request.auth.uid
          || resource.data.toUserId == request.auth.uid);
      allow delete: if signedIn() && resource.data.fromUserId == request.auth.uid;
    }

    match /passes/{passId} {
      allow create, update: if signedIn()
        && request.resource.data.fromUserId == request.auth.uid
        && passId == request.auth.uid + '_' + request.resource.data.toUserId;
      allow read: if signedIn() && resource.data.fromUserId == request.auth.uid;
      allow delete: if signedIn() && resource.data.fromUserId == request.auth.uid;
    }

    match /matches/{matchId} {
      allow create: if signedIn()
        && request.resource.data.userIds is list
        && request.auth.uid in request.resource.data.userIds
        && hasBothLikes(request.resource.data.userIds)
        && (matchId == request.resource.data.userIds[0] + '_' + request.resource.data.userIds[1]
          || matchId == request.resource.data.userIds[1] + '_' + request.resource.data.userIds[0]);
      allow read: if signedIn() && request.auth.uid in resource.data.userIds;
      allow update: if signedIn()
        && request.auth.uid in resource.data.userIds
        && request.resource.data.userIds == resource.data.userIds
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'lastMessage',
          'lastMessageAt',
          'createdAt'
        ]);
      allow delete: if signedIn() && request.auth.uid in resource.data.userIds;

      match /messages/{messageId} {
        allow read: if isMatchMember(matchId);
        allow create: if isMatchMember(matchId)
          && request.resource.data.senderId == request.auth.uid
          && request.resource.data.text is string
          && request.resource.data.text.size() > 0;
        allow update: if isMatchMember(matchId)
          && resource.data.senderId == request.auth.uid
          && request.resource.data.senderId == request.auth.uid;
        allow delete: if isMatchMember(matchId) && resource.data.senderId == request.auth.uid;
      }
    }
  }
}
